{
  "name": "debo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test --cache=local:r,remote:r",
    "typecheck": "turbo run typecheck --cache=local:r,remote:r",
    "lint": "bun node_modules/prettier/bin/prettier.cjs --check \"{packages,apps}/**/*.{ts,tsx,js,json}\"",
    "format": "bun node_modules/prettier/bin/prettier.cjs --write \"{packages,apps}/**/*.{ts,tsx,js,json}\""
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "bun-types": "^1.4.2",
    "prettier": "^3.9.9",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  }
}
